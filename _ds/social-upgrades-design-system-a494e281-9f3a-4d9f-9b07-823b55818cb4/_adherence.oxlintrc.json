{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/marketing/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cta|dark|gradient|outline-dark|outline-light|pill-light)$/]",
        "message": "<Button> variant must be one of 'cta' | 'dark' | 'gradient' | 'outline-dark' | 'outline-light' | 'pill-light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|nested|bold|key|ref|className|style|children)$/]",
        "message": "<CheckListItem> doesn't accept that prop. Declared props: text, nested, bold."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|textarea|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, textarea."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|wordmark|height|stacked|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, wordmark, height, stacked."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|mono-navy|mono-white|on-dark)$/]",
        "message": "<Logo> variant must be one of 'full' | 'mono-navy' | 'mono-white' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onNav|transparent|style|key|ref|className|style|children)$/]",
        "message": "<Navbar> doesn't accept that prop. Declared props: items, active, onNav, transparent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|per|buyout|features|cta|onCta|style|key|ref|className|style|children)$/]",
        "message": "<PlanCard> doesn't accept that prop. Declared props: name, description, price, per, buyout, features, cta, onCta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|sub|dark|size|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: kicker, title, sub, dark, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<SectionHeader> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|angle|style|key|ref|className|style|children)$/]",
        "message": "<StepCard> doesn't accept that prop. Declared props: icon, title, children, angle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickerBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|href|speed|style|key|ref|className|style|children)$/]",
        "message": "<TickerBar> doesn't accept that prop. Declared props: text, href, speed, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
