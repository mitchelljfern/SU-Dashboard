{
  "name": "su-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Social Upgrades Client Hub — web dashboard (public/) and the native iOS shell (ios/) that wraps it.",
  "scripts": {
    "serve": "npx serve public",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "build:native": "esbuild app/native/entry.js --bundle --format=iife --target=safari16 --outfile=public/su-native.app.js"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
